{% block _exception_widget %}
    {% set attr = attr|merge({
        class: attr.class|default('') ~ " text-center exception-page"
    }) %}
    <div {{ block('block_attributes') }}>
        <h1 class=" page-title">
            <span class="page-title__text">
                {{ status_code }}
            </span>
            <span class="page-title__subtext">{{ status_text }}</span>
        </h1>
        <div class="exception-page__content">
            <p>
                {% if status_code == 404 %}
                    {{ 'oro_frontend.exception.code.404'|trans }}
                {% elseif status_code == 403 %}
                    {{ 'oro_frontend.exception.code.403'|trans }}
                {% else %}
                    {{ 'oro_frontend.exception.default'|trans }}
                {% endif %}
            </p>
        </div>
        {% if status_code == 404 or status_code == 403 %}
            <picture>
                <img src="/bundles/acmetheme/acme/images/logo-small.svg" alt="logo acme">
            </picture>
            <div class="exception-page__action"><a href="#" onclick="window.history.back(); return false;">{{ 'oro_frontend.exception.back'|trans }}</a></div>
        {% endif %}
    </div>
{% endblock %}

