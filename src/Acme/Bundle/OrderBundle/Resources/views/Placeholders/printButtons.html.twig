{% import '@OroUI/macros.html.twig' as UI %}

{% block printButtons %}
    <div class="btn-group">
        {% set buttonsHtml %}
            <a href="#" target="_blank" role="button" class="btn icons-holder-text no-hash">
                <span class="fa-file-o hide-text"></span>{{ 'acme.order.print.no_price.label'|trans }}
            </a>
            <a href="#" target="_blank" role="button" class="btn icons-holder-text no-hash">
                <span class="fa-file-text-o hide-text"></span>{{ 'acme.order.print.net_price.label'|trans }}
            </a>
            <a href="#" target="_blank" role="button" class="btn icons-holder-text no-hash">
                <span class="fa-file-text hide-text"></span>{{ 'acme.order.print.msrp.label'|trans }}
            </a>
        {% endset %}

        {% set parameters = {
            'html': buttonsHtml
        } %}
        {{ UI.pinnedDropdownButton(parameters) }}
    </div>
{% endblock printButtons %}
