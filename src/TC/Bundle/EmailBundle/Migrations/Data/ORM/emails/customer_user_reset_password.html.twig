@name = customer_user_reset_password
@entityName = Oro\Bundle\CustomerBundle\Entity\CustomerUser
@subject = Reset User Account Password
@isSystem = 1
@isEditable = 1

{% extends oro_get_email_template('base_storefront') %}

{% block content %}
    <h1 style="{{ styleH1 }}">Hi {{ entity|oro_format_name }},</h1>

    <p style="{{ styleP }}">To reset your password - please visit
        <a href="{{
        website_path('oro_customer_frontend_customer_user_password_reset', { token: entity.confirmationToken }, entity.website)
        }}" style="{{ styleLink }}">this link</a>
    </p>
{% endblock %}
